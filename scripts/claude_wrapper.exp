#!/usr/bin/expect -f
# Claude Code を起動して、 初回 UI 壁 [Bypass Permissions / Trust folder] を自動 accept する wrapper
# 既に accept 済 project なら expect は何もせず素通り、 起動後は interact で user に対話を渡す
# 出典: https://zenn.dev/pepabo/articles/claude-code-cron-autonomous-ui-walls
#
# 使い方:
#   screen -dmS secretary bash -c "cd ~/secretary && expect ~/secretary/scripts/claude_wrapper.exp"
# 追加引数を渡したい場合:
#   expect ~/secretary/scripts/claude_wrapper.exp -- --model opus

set timeout 30
log_user 1

# 呼び出し側から追加引数受け取り対応
eval spawn claude --dangerously-skip-permissions --channels plugin:discord@claude-plugins-official $argv

# 壁1 [Bypass Permissions 確認] と壁2 [Trust this folder] を順不同で待つ
# 通常 accept 済なら即起動完了 prompt に到達 → timeout で抜ける
expect {
    -re {Bypass.*[Pp]ermissions} {
        # 「Yes, I accept」を選択するため下矢印 + Enter
        # 注: expect/tcl では文字列内 `[]` が command substitution と解釈されるため、
        # regex は `{}` で囲んで literal として渡す。 send 引数の `\[` はエスケープ済 `[` で OK。
        send "\033\[B"
        send "\r"
        exp_continue
    }
    -re {[Tt]rust.*folder} {
        send "\r"
        exp_continue
    }
    -re {Welcome to Claude Code|Try.*help|Tip:|❯} {
        # 起動完了プロンプトを検知、 抜ける
    }
    timeout {
        puts "\nexpect: no UI prompts hit within ${timeout}s, claude probably already started"
    }
}

# 起動完了後は user [screen attach] に対話を渡す
interact
