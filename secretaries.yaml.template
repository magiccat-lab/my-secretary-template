# 秘書設定ファイル
# cp secretaries.yaml.template secretaries.yaml して編集
# 1体だけなら secretaries: の下に1つだけ書けばOK

version: 1
default_secretary: haru

runtime:
  home: "~/secretary"
  webhook_port_env: WEBHOOK_PORT        # .env の変数名を参照
  webhook_token_env: WEBHOOK_TOKEN
  mode: single                          # single | multi（multi は将来の複数Claude常駐用）

secretaries:
  haru:
    display_name: "ハル"                 # Discord 上の表示名
    identity: "AGENT/IDENTITY.md"       # キャラ定義ファイル（1体目はデフォルトそのまま）
    sender:
      kind: bot_token                   # bot_token | webhook
      # bot_token の場合: ~/.claude/channels/discord/.env の DISCORD_BOT_TOKEN を使う
      # webhook の場合: 下の webhook_url_env で .env の変数名を指定
      webhook_url_env: ""               # 例: DISCORD_WEBHOOK_HARU
    channels:
      default_env: DISCORD_CHANNEL_RANDOM
      allowlist_envs:                   # この秘書が担当するチャンネル（空なら全部）
        - DISCORD_CHANNEL_RANDOM
    state:
      data_dir: "data"                  # 1体目はデフォルトの data/ を使う
      tasks: "data/pending_tasks.json"
      handoff: "data/handoff.md"
    jobs:
      enabled_tags:                     # この秘書が担当するジョブタグ
        - all                           # all なら全ジョブ

