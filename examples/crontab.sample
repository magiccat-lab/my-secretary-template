# my-secretary-template sample cron
0 8 * * * cd /opt/my-secretary-template && python3 scripts/lib/cron_gate.py daily_brief --min-interval 82800 || exit 0; python3 templates/onboarded/daily_brief.py
*/5 * * * * cd /opt/my-secretary-template && python3 scripts/lib/cron_gate.py gcal_remind --min-interval 240 --allow-quiet || exit 0; python3 scripts/integrations/gcal/gcal_remind.py
0 3 * * * cd /opt/my-secretary-template && python3 scripts/lib/cron_gate.py discord_log_sync --min-interval 82800 || exit 0; python3 scripts/integrations/discord/sync_log_to_notion.py
0 8 * * * cd /opt/my-secretary-template && python3 scripts/lib/cron_gate.py sample_recommend --min-interval 82800 || exit 0; python3 scripts/recommendations/sample_scrape_recommend.py
*/10 * * * * cd /opt/my-secretary-template && python3 templates/onboarded/health_ping.py >/tmp/my-secretary-health.log 2>&1
15 9 * * 1-5 cd /opt/my-secretary-template && python3 templates/onboarded/task_digest.py
30 3 * * * cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_HANDOFF" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py nightly_handoff --min-interval 82800 --allow-quiet || exit 0; python3 scripts/system/nightly_handoff.py
*/5 * * * * cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_GMAIL" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py gmail_monitor --min-interval 240 --allow-quiet || exit 0; python3 integrations/gmail/gmail_monitor.py
30 21 * * * cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_DIARY" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py diary_prompt --min-interval 82800 --allow-quiet || exit 0; python3 scripts/diary/daily_prompt.py
*/15 * * * * cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_DIARY" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py diary_writer --min-interval 600 --allow-quiet || exit 0; python3 scripts/diary/diary_writer.py
0 5 * * 1 cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_TRAINER" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py trainer_memory --min-interval 604800 --allow-quiet || exit 0; python3 scripts/trainer/memory_extractor.py
15 5 * * 1 cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_TRAINER" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py trainer_persona --min-interval 604800 --allow-quiet || exit 0; python3 scripts/trainer/persona_evolution.py
30 5 * * 1 cd /opt/my-secretary-template && set -a; [ -f .env ] && . ./.env; set +a; [ "$FEATURE_TRAINER" = "true" ] || exit 0; python3 scripts/lib/cron_gate.py trainer_til --min-interval 604800 --allow-quiet || exit 0; python3 scripts/trainer/til_promoter.py
